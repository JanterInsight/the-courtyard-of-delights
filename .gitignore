# -------------------------------
*.log
*.tmp
*.temp
*.cache
.tmp/
.temp/

# -------------------------------
# Environment & Config
# -------------------------------
.env
.env.*
!.env.example
.env.local
.env.development
.env.production
.env.test
.config/
.local/

