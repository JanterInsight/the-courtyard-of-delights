# Windows
Thumbs.db
Thumbs.db:encryptable
Desktop.ini
*.lnk

# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.fseventsd
.hotfiles.btree

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# -------------------------------
# IDE & Editor Files
# -------------------------------
# VSCode
.vscode/
*.code-workspace

# IntelliJ / JetBrains
.idea/
*.iml
*.ipr
*.iws

# Vim
*.swp
*.swo
*~

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc
auto-save-list
tramp
.\#*

# Sublime Text
*.sublime-workspace
*.sublime-project

# -------------------------------
# Dependencies
# -------------------------------
# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
yarn.lock
.pnpm-debug.log*

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
pip-log.txt
pip-delete-this-directory.txt
.pytest_cache/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.tox/
.nox/

# -------------------------------
# Build & Compiled Files
# -------------------------------
**/dist/
/build/
/out/
*.bin
*.out
*.exe
*.dll
*.so
*.dylib

# -------------------------------
